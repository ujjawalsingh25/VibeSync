{
  "expo": {
    "name": "VibeSync_DevMode",
    "slug": "VibeSync_DevMode",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/main_logo_lightTheme.png",
    "scheme": "vibesyncdevmode",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logo/main_logo_lightTheme.png",
      "bundleIdentifier": "com.anonymous.VibeSync-DevMode"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo/main_logo_lightTheme.png",
        "backgroundImage": "./assets/logo/main_logo_lightTheme.png",
        "monochromeImage": "./assets/logo/main_logo_lightTheme.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.VibeSync_DevMode",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo/main_logo_lightTheme.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/logo/main_logo_lightTheme.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "audio",
            "photo"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
